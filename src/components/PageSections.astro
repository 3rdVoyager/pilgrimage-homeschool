---
import { marked } from "marked";
import type { PageContent } from "../types/content";

interface Props {
  page: PageContent;
}

const { page } = Astro.props;
---

{
  page.sections.map((section) => {
    return (
      <section
        id={section.id}
        class:list={[
          "page-section",
          `page-section-${section.color}`,
          `page-section-layout-${section.layout}`,
        ]}
      >
        <div class="section-content" set:html={marked.parse(section.content)} />
      </section>
    );
  })
}
