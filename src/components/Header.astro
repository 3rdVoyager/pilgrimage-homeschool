---
import DropdownMenu from "./DropdownMenu.astro";

const navItems = [
  { label: "Home", href: "/" },
  {
    label: "About",
    items: [
      { label: "About Us", href: "/about/" },
      { label: "Our Staff", href: "/staff/" },
    ],
  },
  { label: "Contact", href: "/contact/" },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <nav>
    <a href="/">
      <img
        src="/assets/favicon/favicon.svg"
        class="brand-logo"
        alt="Pilgrimage Homeschool logo"
      />
      <span>Pilgrimage Homeschool</span>
    </a>

    <ul>
      {
        navItems.map((item) => (
          item.items ? (
            <DropdownMenu
              label={item.label}
              items={item.items}
              currentPath={currentPath}
            />
          ) : (
            <li>
              <a
                href={item.href}
                class:list={["nav-link", currentPath === item.href && "active"]}
              >
                {item.label}
              </a>
            </li>
          )
        ))
      }
    </ul>
  </nav>
</header>