---
import DropdownMenu from "./DropdownMenu.astro";
import type { SiteSettings } from "../types/content";

type Props = SiteSettings["header"];
const { siteName, logoAlt, navItems } = Astro.props as Props;
const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <nav>
    <a href="/">
      <img
          src="/favicon/favicon.svg"
        class="brand-logo"
        alt={logoAlt}
      />
      <span>{siteName}</span>
    </a>

    <ul>
      {
        navItems.map((item) => (
          item.items?.length ? (
            <DropdownMenu
              label={item.label}
              items={item.items}
              currentPath={currentPath}
            />
          ) : (
            <li>
              <a
                href={item.href}
                class:list={["nav-link", currentPath === item.href && "active"]}
              >
                {item.label}
              </a>
            </li>
          )
        ))
      }
    </ul>
  </nav>
</header>