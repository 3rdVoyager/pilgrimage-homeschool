---
type FooterLink = {
  label: string;
  href?: string;
};

type FooterColumn = {
  title: string;
  links: FooterLink[];
};

const footerColumns: FooterColumn[] = [
  {
    title: "Explore",
    links: [
      { label: "Home", href: "/" },
      { label: "About Us", href: "/about/" },
      { label: "Our Staff", href: "/staff/" },
    ],
  },
  {
    title: "More Information",
    links: [
      { label: "Join the Team" },
      { label: "Resources" },
      { label: "Activities" },
    ],
  },
  {
    title: "Connect",
    links: [{ label: "Contact Us", href: "/contact/" }],
  },
];
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a class="footer-logo" href="/">
        <img
          src="/assets/favicon/favicon.svg"
          alt="Pilgrimage Homeschool logo"
        />
        <span>Pilgrimage Homeschool</span>
      </a>
      <p>
        A competitive homeschool Science Olympiad Team for students in grades 3-12.
      </p>
    </div>

    <div class="footer-columns">
      {
        footerColumns.map((column) => (
          <div class="footer-column">
            <h2>{column.title}</h2>
            <ul>
              {column.links.map((link) => (
                <li>
                  {link.href ? (
                    <a href={link.href!}>{link.label}</a>
                  ) : (
                    <span class="footer-link-placeholder">{link.label}</span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>

  <div class="footer-bottom">
    <p>
      &copy; {new Date().getFullYear()} Pilgrimage Homeschool Science Olympiad
      Team. All rights reserved.
    </p>
  </div>
</footer>
