---
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/Card.astro";

const resources = [
  {
    title: "Benefits of Science Olympiad",
    description:
      "An introduction to the opportunities and benefits of participating in Science Olympiad.",
    category: "Getting started",
    href: "https://drive.google.com/file/d/10zO-7GfzKbILcVrCv_DdBW95TY_Azywb/view?usp=drive_link",
    external: true,
  },
  {
    title: "Types of Events",
    description:
      "Learn how study, build, and lab events give students different ways to explore science.",
    category: "Getting started",
    href: "https://drive.google.com/open?id=10dLcHvW_POvParv6cjmmaiRft3xAGoun&usp=drive_copy",
    external: true,
  },
  {
    title: "Typical Season",
    description:
      "An overview of what students and families can expect throughout a Science Olympiad season.",
    category: "Getting started",
    href: "https://drive.google.com/open?id=10juSPKzjziNYL1sujXyJ8A_cS9dhLZrh&usp=drive_copy",
    external: true,
  },
  {
    title: "What Is Science Olympiad?",
    description:
      "An article explaining the competition and what students can expect from Science Olympiad.",
    category: "Getting started",
    href: "https://drive.google.com/open?id=1zLPMbITxz-WeAfeBmo3_3NWesQ1XkwBB&usp=drive_copy",
    external: true,
  },
  {
    title: "Locations to Find Tests",
    description:
      "A small guide to finding practice tests for study event preparation.",
    category: "Study and preparation",
    href: "https://drive.google.com/open?id=1JBdPNjAbY_Y0SJ8vWhj4xk7keKXK9X54&usp=drive_copy",
    external: true,
  },
  {
    title: "Team Expectations",
    description:
      "Expectations for Pilgrimage Homeschool students and families.",
    category: "Team information",
    href: "https://drive.google.com/open?id=16zQ40Hb9CtiUEHltu39m8es5-Fnz3W-f&usp=drive_copy",
    external: true,
  },
  {
    title: "Science Olympiad Companion for Students",
    description:
      "A student guide for learning about Science Olympiad and preparing for events.",
    category: "Study and preparation",
    href: "https://drive.google.com/open?id=1acHjsBoNsRmxcVIy4Q1uxLC76QEtFYIH&usp=drive_copy",
    external: true,
  },
  {
    title: "Study Event Resources",
    description:
      "A directory of resources to help students prepare for study events.",
    category: "Study and preparation",
    href: "https://drive.google.com/open?id=1Qn1fgdJJ1d-5IFK58VYUIdVBN7cT53xR&usp=drive_copy",
    external: true,
  },
  {
    title: "Team Code of Conduct",
    description:
      "The Pilgrimage Homeschool Science Olympiad Team code of conduct.",
    category: "Team information",
    href: "https://drive.google.com/open?id=1mRY-jBfqNNbpTgrNqgeY-1rq2fck6MC4&usp=drive_copy",
    external: true,
  },
  {
    title: "Pilgrimage Study Center (In Development)",
    description:
      "Explore the developing study center for additional guides, practice tests, and event resources.",
    category: "Pilgrimage resource",
    href: "https://pilgrimagestudycenter.pages.dev",
    external: true,
  },
];
---

<BaseLayout title="Resources | Pilgrimage Homeschool">
  <section class="page-hero">
    <h1>Resources</h1>
    <p class="hero-lede">
      Starting points and study materials for families learning about Science
      Olympiad.
    </p>
  </section>

  <section class="page-section">
    <h2>Science Olympiad resources</h2>
    <p>
      Explore these materials to learn about the competition, prepare for
      events, and understand what it means to be part of the Pilgrimage team.
    </p>

    <div class="card-grid" style="--grid-min-width: 36rem;">
      {
        resources.map((resource) => (
          <Card variant="resource">
            <p class="resource-category">{resource.category}</p>
            <h3>{resource.title}</h3>
            <p>{resource.description}</p>
            {
              resource.href && (
                <a
                  class="resource-link"
                  href={resource.href}
                  target={resource.external ? "_blank" : undefined}
                  rel={resource.external ? "noopener noreferrer" : undefined}
                >
                  {resource.external ? "Visit resource" : "Learn more"}{" "}
                  <span aria-hidden="true">→</span>
                </a>
              )
            }
          </Card>
        ))
      }
    </div>
  </section>
</BaseLayout>
